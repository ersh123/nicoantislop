+      this.pendingExplicitAgents += 1
+    }
+    let released = false
+    return {
+      release: () => {
+        if (released) {
+          return
+        }
+        released = true
+        this.pendingStarts = Math.max(0, this.pendingStarts - 1)
+        if (input.explicitAgent) {
+          this.pendingExplicitAgents = Math.max(0, this.pendingExplicitAgents - 1)
+        }
+      }
+    }
+  }
+
+  snapshot(): TerminalSpawnAdmissionSnapshot {
+    return {
+      pendingStarts: this.pendingStarts,
+      pendingExplicitAgents: this.pendingExplicitAgents
+    }
+  }
+
+  private resolveExplicitAgentLimit(): number {
+    const memory = this.readMemory()
+    if (!memory) {
+      return Math.min(this.hardMaxExplicitAgents, this.fallbackExplicitAgentLimit)
+    }
+    const reservedBytes =
+      this.reservedHostMemoryBytes ??
+      Math.max(4 * GiB, Math.floor(memory.totalBytes * DEFAULT_RESERVED_MEMORY_FRACTION))
+    const usableBytes = Math.max(0, memory.availableBytes - reservedBytes)
+    const memoryLimit = Math.floor(usableBytes / this.estimatedExplicitAgentBytes)
+    return Math.max(0, Math.min(this.hardMaxExplicitAgents, memoryLimit))
+  }
+}
+
+export function createHardenedTerminalSpawnAdmission(
+  env: NodeJS.ProcessEnv = process.env
+): TerminalSpawnAdmission {
+  return new TerminalSpawnAdmission({
+    maxConcurrentStarts: envPositiveInteger(env.ORCA_HARDENED_MAX_CONCURRENT_STARTS),
+    maxLiveTerminals: envPositiveInteger(env.ORCA_HARDENED_MAX_TERMINALS),
+    hardMaxExplicitAgents: envPositiveInteger(env.ORCA_HARDENED_MAX_AGENTS),
+    reservedHostMemoryBytes: envNonNegativeGiB(env.ORCA_HARDENED_RESERVED_MEMORY_GIB),
+    estimatedExplicitAgentBytes: envPositiveMiB(env.ORCA_HARDENED_AGENT_ESTIMATE_MIB),
+    fallbackExplicitAgentLimit: envPositiveInteger(env.ORCA_HARDENED_FALLBACK_AGENTS)
+  })
+}
+
+export function readLinuxMemorySnapshot(): TerminalSpawnMemorySnapshot | null {
+  if (process.platform !== 'linux') {
+    return null
+  }
+  try {
+    const fields = new Map<string, number>()
+    for (const line of readFileSync('/proc/meminfo', 'utf8').split('\n')) {
+      const match = /^([^:]+):\s+(\d+)\s+kB$/.exec(line)
+      if (match) {
+        fields.set(match[1], Number(match[2]) * 1024)
+      }
+    }
+    const totalBytes = fields.get('MemTotal')
+    const availableBytes = fields.get('MemAvailable')
+    return totalBytes && availableBytes !== undefined ? { totalBytes, availableBytes } : null
+  } catch {
+    return null
+  }
+}
+
+function envPositiveInteger(raw: string | undefined): number | undefined {
+  if (!raw?.trim()) {
+    return undefined
+  }
+  const value = Number(raw)
+  return Number.isFinite(value) && value > 0 ? Math.floor(value) : undefined
+}
+
+function envNonNegativeGiB(raw: string | undefined): number | undefined {
+  if (!raw?.trim()) {
+    return undefined
+  }
+  const value = Number(raw)
+  return Number.isFinite(value) && value >= 0 ? value * GiB : undefined
+}
+
+function envPositiveMiB(raw: string | undefined): number | undefined {
+  if (!raw?.trim()) {
+    return undefined
+  }
+  const value = Number(raw)
+  return Number.isFinite(value) && value > 0 ? value * MiB : undefined
+}
+
+function positiveInteger(value: number | undefined, fallback: number): number {
+  return typeof value === 'number' && Number.isFinite(value) && value > 0
+    ? Math.floor(value)
+    : fallback
+}
+
+function positiveNumber(value: number | undefined, fallback: number): number {
+  return typeof value === 'number' && Number.isFinite(value) && value > 0 ? value : fallback
+}
+
+function optionalNonNegativeNumber(value: number | undefined): number | null {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : null
+}
