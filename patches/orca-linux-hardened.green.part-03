+    ]
+  }
+}
+
+export async function createLinuxTerminalProcessBoundary(input: {
+  enabled: boolean
+  sessionId: string
+  shellPath: string
+  shellArgs: readonly string[]
+  nonce?: string
+  runProcess?: RunProcess
+  env?: NodeJS.ProcessEnv
+}): Promise<LinuxTerminalProcessBoundary | null> {
+  if (!input.enabled) {
+    return null
+  }
+  const runProcess = input.runProcess ?? defaultRunProcess
+  if (!(await systemdUserManagerAvailable(runProcess))) {
+    return null
+  }
+  const launch = buildLinuxTerminalScopeLaunch({
+    sessionId: input.sessionId,
+    nonce: input.nonce ?? randomUUID(),
+    shellPath: input.shellPath,
+    shellArgs: input.shellArgs,
+    env: input.env
+  })
+  const completedSignals = new Set<LinuxTerminalBoundarySignal>()
+  return {
+    ...launch,
+    async terminate(signal) {
+      if (completedSignals.has(signal)) {
+        return 'terminated'
+      }
+      const result = await runProcess({
+        program: 'systemctl',
+        args: ['--user', 'kill', '--kill-whom=all', `--signal=${signal}`, launch.unitName],
+        timeoutMs: 5_000,
+        maxOutputBytes: 256 * 1024
+      }).catch(() => null)
+      if (!result || result.timedOut || result.code !== 0) {
+        return 'unverifiable'
+      }
+      completedSignals.add(signal)
+      return 'terminated'
+    }
+  }
+}
+
+export function resetLinuxTerminalBoundarySupportForTests(): void {
+  supportProbe = null
+}
+
+function systemdUserManagerAvailable(runProcess: RunProcess): Promise<boolean> {
+  supportProbe ??= runProcess({
+    program: 'systemctl',
+    args: ['--user', 'show-environment'],
+    timeoutMs: 3_000,
+    maxOutputBytes: 64 * 1024
+  })
+    .then(async (result) => {
+      if (result.timedOut || result.code !== 0) {
+        return false
+      }
+      // The Debian post-install drops the slice into /usr/lib/systemd/user.
+      // Reload here so an already-running user manager sees it without logout.
+      await runProcess({
+        program: 'systemctl',
+        args: ['--user', 'daemon-reload'],
+        timeoutMs: 3_000,
+        maxOutputBytes: 64 * 1024
+      }).catch(() => null)
+      return true
+    })
+    .catch(() => false)
+  return supportProbe
+}
+
+function normalizeUnitToken(value: string): string {
+  const normalized = value.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 24)
+  return normalized || 'session'
+}
+
+function normalizedSystemdSize(raw: string | undefined, fallback: string): string {
+  return raw && /^\d+(?:\.\d+)?[KMGTP]$/i.test(raw.trim()) ? raw.trim().toUpperCase() : fallback
+}
+
+function normalizedPositiveInteger(raw: string | undefined, fallback: number): number {
+  const value = raw?.trim() ? Number(raw) : Number.NaN
+  return Number.isFinite(value) && value > 0 ? Math.floor(value) : fallback
+}
