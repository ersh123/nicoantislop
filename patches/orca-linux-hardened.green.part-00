diff --git a/config/scripts/build-linux-hardened.test.mjs b/config/scripts/build-linux-hardened.test.mjs
new file mode 100644
index 00000000..17c57510
--- /dev/null
+++ b/config/scripts/build-linux-hardened.test.mjs
@@ -0,0 +1,70 @@
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import {
+  buildLinuxElectronBuilderArgs,
+  runLocalLinuxBuild,
+  writeHardenedBuildManifest
+} from './build-linux-local.mjs'
+
+const tempDirs = []
+afterEach(() => {
+  for (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true })
+})
+
+describe('hardened Linux local build', () => {
+  it('requests only a Debian artifact', () => {
+    const args = buildLinuxElectronBuilderArgs('x64', [], true)
+    expect(args).toEqual(
+      expect.arrayContaining(['--config', 'config/electron-builder.config.cjs', '--linux', 'deb', '--x64'])
+    )
+    expect(args).not.toContain('AppImage')
+    expect(args).not.toContain('rpm')
+  })
+
+  it('writes reproducible build identity before invoking electron-builder', () => {
+    const cwd = mkdtempSync(join(tmpdir(), 'orca-hardened-build-'))
+    tempDirs.push(cwd)
+    const execFile = vi.fn()
+    const environment = {
+      PATH: '/bin',
+      ORCA_HARDENED_LINUX: '1',
+      ORCA_HARDENED_UPSTREAM_SHA: 'abc123',
+      ORCA_HARDENED_BUILD_RUN: '42',
+      ORCA_LOCAL_BUILD_VERSION: '1.4.197-hardened.1'
+    }
+
+    runLocalLinuxBuild({ arch: 'x64', environment, execFile, platform: 'linux', cwd })
+
+    expect(execFile).toHaveBeenCalledWith(
+      'pnpm',
+      buildLinuxElectronBuilderArgs('x64', [], true),
+      expect.objectContaining({ cwd, env: expect.objectContaining(environment), stdio: 'inherit' })
+    )
+    expect(
+      JSON.parse(
+        readFileSync(join(cwd, 'resources/linux/packaging/build-manifest.json'), 'utf8')
+      )
+    ).toEqual({
+      product: 'Orca Hardened',
+      upstream: 'stablyai/orca',
+      upstreamSha: 'abc123',
+      buildRun: '42',
+      version: '1.4.197-hardened.1'
+    })
+  })
+
+  it('can write the manifest directly for release tooling', () => {
+    const cwd = mkdtempSync(join(tmpdir(), 'orca-hardened-manifest-'))
+    tempDirs.push(cwd)
+    writeHardenedBuildManifest(cwd, {
+      ORCA_HARDENED_UPSTREAM_SHA: 'sha',
+      ORCA_HARDENED_BUILD_RUN: 'run',
+      ORCA_LOCAL_BUILD_VERSION: 'version'
+    })
+    expect(readFileSync(join(cwd, 'resources/linux/packaging/build-manifest.json'), 'utf8')).toContain(
+      '"upstreamSha": "sha"'
+    )
+  })
+})
diff --git a/config/scripts/build-linux-local.mjs b/config/scripts/build-linux-local.mjs
index 2328f00b..9c162839 100644
--- a/config/scripts/build-linux-local.mjs
+++ b/config/scripts/build-linux-local.mjs
@@ -1,6 +1,7 @@
 #!/usr/bin/env node
 
 import { execFileSync } from 'node:child_process'
+import { mkdirSync, writeFileSync } from 'node:fs'
 import { resolve } from 'node:path'
 
 const SUPPORTED_ARCHES = new Set(['x64', 'arm64'])
@@ -20,7 +21,11 @@ export function resolveLinuxBuildArch({
   return arch
 }
 
-export function buildLinuxElectronBuilderArgs(arch, extraArgs = []) {
+export function buildLinuxElectronBuilderArgs(
+  arch,
+  extraArgs = [],
+  hardened = process.env.ORCA_HARDENED_LINUX === '1'
+) {
   if (!SUPPORTED_ARCHES.has(arch)) {
     throw new Error(`Unsupported Linux build architecture: ${arch}`)
   }
@@ -30,9 +35,7 @@ export function buildLinuxElectronBuilderArgs(arch, extraArgs = []) {
     '--config',
     'config/electron-builder.config.cjs',
     '--linux',
-    'AppImage',
-    'deb',
-    'rpm',
+    ...(hardened ? ['deb'] : ['AppImage', 'deb', 'rpm']),
     `--${arch}`,
     ...extraArgs
   ]
@@ -52,14 +55,38 @@ export function runLocalLinuxBuild({
   } else {
     delete env.ORCA_LINUX_ARM64_RELEASE
   }
+  if (env.ORCA_HARDENED_LINUX === '1') {
+    writeHardenedBuildManifest(cwd, env)
+  }
   const pnpm = platform === 'win32' ? 'pnpm.cmd' : 'pnpm'
-  execFile(pnpm, buildLinuxElectronBuilderArgs(arch, extraArgs), {
+  execFile(pnpm, buildLinuxElectronBuilderArgs(arch, extraArgs, env.ORCA_HARDENED_LINUX === '1'), {
     cwd,
     env,
     stdio: 'inherit'
   })
 }
 
