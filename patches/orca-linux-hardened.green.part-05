diff --git a/src/main/daemon/terminal-spawn-admission.test.ts b/src/main/daemon/terminal-spawn-admission.test.ts
new file mode 100644
index 00000000..7fe27963
--- /dev/null
+++ b/src/main/daemon/terminal-spawn-admission.test.ts
@@ -0,0 +1,200 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { SubprocessHandle } from './session-subprocess-handle'
+import { TerminalHost } from './terminal-host'
+import {
+  createHardenedTerminalSpawnAdmission,
+  TerminalSpawnAdmission,
+  TerminalSpawnAdmissionError
+} from './terminal-spawn-admission'
+
+const GiB = 1024 ** 3
+
+function policy(overrides: ConstructorParameters<typeof TerminalSpawnAdmission>[0] = {}) {
+  return new TerminalSpawnAdmission({
+    maxConcurrentStarts: 2,
+    maxLiveTerminals: 4,
+    hardMaxExplicitAgents: 6,
+    reservedHostMemoryBytes: 4 * GiB,
+    estimatedExplicitAgentBytes: 1536 * 1024 ** 2,
+    readMemory: () => ({ totalBytes: 16 * GiB, availableBytes: 12 * GiB }),
+    ...overrides
+  })
+}
+
+function reserve(
+  admission: TerminalSpawnAdmission,
+  input: Partial<Parameters<TerminalSpawnAdmission['reserve']>[0]> = {}
+) {
+  return admission.reserve({
+    sessionId: input.sessionId ?? 'term-1',
+    explicitAgent: input.explicitAgent ?? false,
+    liveTerminals: input.liveTerminals ?? 0,
+    liveExplicitAgents: input.liveExplicitAgents ?? 0
+  })
+}
+
+function expectAdmissionCode(action: () => unknown, code: string): void {
+  try {
+    action()
+    throw new Error('expected admission refusal')
+  } catch (error) {
+    expect(error).toBeInstanceOf(TerminalSpawnAdmissionError)
+    expect((error as TerminalSpawnAdmissionError).code).toBe(code)
+  }
+}
+
