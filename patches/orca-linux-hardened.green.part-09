diff --git a/src/renderer/src/components/native-chat/use-native-chat-composer-attachments-unmount.test.tsx b/src/renderer/src/components/native-chat/use-native-chat-composer-attachments-unmount.test.tsx
new file mode 100644
index 00000000..e8e2c55d
