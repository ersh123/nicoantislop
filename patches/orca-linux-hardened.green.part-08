+      .mockImplementationOnce(() => {
+        throw new Error('database busy')
+      })
+      .mockReturnValue({ disposition: 'requested' as const, resource: resource() })
+    const db = {
+      listWorkerTerminalResources: () => [
+        row('one', 'reclaimable'),
+        row('two', 'reclaimable'),
+        row('three', 'reclaimable')
+      ],
+      requestWorkerTerminalRelease
+    }
+
+    const result = requestReclaimableWorkerTerminalReleases(db, { maxRequests: 2 })
+
+    expect(requestWorkerTerminalRelease.mock.calls).toEqual([['one'], ['two']])
+    expect(result).toEqual({ examined: 3, requested: 0, retained: 1, failed: 1 })
+  })
+})
diff --git a/src/main/runtime/orchestration/worker-terminal-auto-release.ts b/src/main/runtime/orchestration/worker-terminal-auto-release.ts
new file mode 100644
index 00000000..0d5b7680
--- /dev/null
+++ b/src/main/runtime/orchestration/worker-terminal-auto-release.ts
@@ -0,0 +1,93 @@
+import type { DispatchStatus, WorkerDispatchState } from './types'
+import type {
+  WorkerTerminalListState,
+  WorkerTerminalResourceRow
+} from './worker-terminal-ownership'
+
+export type WorkerTerminalAutoReleaseResult = {
+  examined: number
+  requested: number
+  retained: number
+  failed: number
+}
+
+type WorkerTerminalAutoReleaseDb = {
+  listWorkerTerminalResources(): {
+    dispatchId: string
+    taskId: string
+    runId: string
+    workerState: WorkerDispatchState | 'unsupervised'
+    dispatchStatus: DispatchStatus
+    agentTerminalHandle: string | null
+    terminalState: WorkerTerminalListState | null
+    resource: WorkerTerminalResourceRow | null
+  }[]
+  requestWorkerTerminalRelease(dispatchId: string):
+    | { disposition: 'requested' | 'already_released'; resource: WorkerTerminalResourceRow }
+    | { disposition: 'retained'; resource: WorkerTerminalResourceRow | null; reason: string }
+}
+
+export function requestReclaimableWorkerTerminalReleases(
+  db: WorkerTerminalAutoReleaseDb,
+  options: { maxRequests?: number } = {}
+): WorkerTerminalAutoReleaseResult {
+  let rows: ReturnType<WorkerTerminalAutoReleaseDb['listWorkerTerminalResources']>
+  try {
+    rows = db.listWorkerTerminalResources()
+  } catch (error) {
+    console.warn('[orchestration] automatic worker terminal inventory failed', error)
+    return { examined: 0, requested: 0, retained: 0, failed: 1 }
+  }
+
+  const result: WorkerTerminalAutoReleaseResult = {
+    examined: rows.length,
+    requested: 0,
+    retained: 0,
+    failed: 0
+  }
+  const maxRequests = positiveInteger(options.maxRequests, 8)
+  let attempted = 0
+  for (const row of rows) {
+    if (attempted >= maxRequests || !isAutoReleasable(row)) {
+      continue
+    }
+    attempted += 1
+    try {
+      const release = db.requestWorkerTerminalRelease(row.dispatchId)
+      if (release.disposition === 'requested' || release.disposition === 'already_released') {
+        result.requested += 1
+      } else {
+        result.retained += 1
+      }
+    } catch (error) {
+      result.failed += 1
+      console.warn('[orchestration] automatic worker terminal release request failed', {
+        dispatchId: row.dispatchId,
+        error: error instanceof Error ? error.message : String(error)
+      })
+    }
+  }
+  return result
+}
+
+function isAutoReleasable(row: {
+  workerState: WorkerDispatchState | 'unsupervised'
+  terminalState: WorkerTerminalListState | null
+  resource: WorkerTerminalResourceRow | null
+}): boolean {
+  const resource = row.resource
+  return Boolean(
+    resource &&
+      row.terminalState === 'reclaimable' &&
+      (row.workerState === 'succeeded' || row.workerState === 'failed') &&
+      resource.ownership_state === 'owned' &&
+      resource.release_state === 'not_requested' &&
+      resource.retained_reason === null
+  )
+}
+
+function positiveInteger(value: number | undefined, fallback: number): number {
+  return typeof value === 'number' && Number.isFinite(value) && value > 0
+    ? Math.floor(value)
+    : fallback
+}
