+import { readFileSync } from 'node:fs'
+
+const MiB = 1024 ** 2
+const GiB = 1024 ** 3
+const DEFAULT_RESERVED_MEMORY_FRACTION = 0.2
+
+export type TerminalSpawnMemorySnapshot = {
+  totalBytes: number
+  availableBytes: number
+}
+
+export type TerminalSpawnAdmissionCode =
+  | 'terminal_spawn_concurrency_limit'
+  | 'terminal_spawn_terminal_limit'
+  | 'terminal_spawn_agent_memory_limit'
+
+export class TerminalSpawnAdmissionError extends Error {
+  constructor(
+    readonly code: TerminalSpawnAdmissionCode,
+    message: string
+  ) {
+    super(message)
+    this.name = 'TerminalSpawnAdmissionError'
+  }
+}
+
+export type TerminalSpawnAdmissionOptions = {
+  maxConcurrentStarts?: number
+  maxLiveTerminals?: number
+  hardMaxExplicitAgents?: number
+  reservedHostMemoryBytes?: number
+  estimatedExplicitAgentBytes?: number
+  fallbackExplicitAgentLimit?: number
+  readMemory?: () => TerminalSpawnMemorySnapshot | null
+}
+
+export type TerminalSpawnReservation = {
+  release(): void
+}
+
+export type TerminalSpawnAdmissionSnapshot = {
+  pendingStarts: number
+  pendingExplicitAgents: number
+}
+
+export class TerminalSpawnAdmission {
+  private readonly maxConcurrentStarts: number
+  private readonly maxLiveTerminals: number
+  private readonly hardMaxExplicitAgents: number
+  private readonly reservedHostMemoryBytes: number | null
+  private readonly estimatedExplicitAgentBytes: number
+  private readonly fallbackExplicitAgentLimit: number
+  private readonly readMemory: () => TerminalSpawnMemorySnapshot | null
+  private pendingStarts = 0
+  private pendingExplicitAgents = 0
+
+  constructor(options: TerminalSpawnAdmissionOptions = {}) {
+    this.maxConcurrentStarts = positiveInteger(options.maxConcurrentStarts, 2)
+    this.maxLiveTerminals = positiveInteger(options.maxLiveTerminals, 24)
+    this.hardMaxExplicitAgents = positiveInteger(options.hardMaxExplicitAgents, 6)
+    this.reservedHostMemoryBytes = optionalNonNegativeNumber(options.reservedHostMemoryBytes)
+    this.estimatedExplicitAgentBytes = positiveNumber(
+      options.estimatedExplicitAgentBytes,
+      1536 * MiB
+    )
+    this.fallbackExplicitAgentLimit = positiveInteger(options.fallbackExplicitAgentLimit, 2)
+    this.readMemory = options.readMemory ?? readLinuxMemorySnapshot
+  }
+
+  reserve(input: {
+    sessionId: string
+    explicitAgent: boolean
+    liveTerminals: number
+    liveExplicitAgents: number
+  }): TerminalSpawnReservation {
+    if (this.pendingStarts >= this.maxConcurrentStarts) {
+      throw new TerminalSpawnAdmissionError(
+        'terminal_spawn_concurrency_limit',
+        `Terminal ${input.sessionId} was not started: ${this.pendingStarts} start(s) are already in progress`
+      )
+    }
+    if (input.liveTerminals + this.pendingStarts >= this.maxLiveTerminals) {
+      throw new TerminalSpawnAdmissionError(
+        'terminal_spawn_terminal_limit',
+        `Terminal ${input.sessionId} was not started: the ${this.maxLiveTerminals}-terminal limit is reached`
+      )
+    }
+    if (input.explicitAgent) {
+      const limit = this.resolveExplicitAgentLimit()
+      if (input.liveExplicitAgents + this.pendingExplicitAgents >= limit) {
+        throw new TerminalSpawnAdmissionError(
+          'terminal_spawn_agent_memory_limit',
+          `Agent ${input.sessionId} was not started: current memory permits ${limit} concurrent explicit agent(s)`
+        )
+      }
+    }
+
+    this.pendingStarts += 1
+    if (input.explicitAgent) {
