diff --git a/src/main/daemon/terminal-session-owned-tree-teardown.test.ts b/src/main/daemon/terminal-session-owned-tree-teardown.test.ts
new file mode 100644
index 00000000..024d2f5f
--- /dev/null
+++ b/src/main/daemon/terminal-session-owned-tree-teardown.test.ts
@@ -0,0 +1,101 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { TerminalSessionTeardown } from './terminal-session-teardown'
+import type { Session } from './session'
+
+const killWithDescendantSweepMock = vi.hoisted(() => vi.fn())
+vi.mock('../pty-descendant-termination', () => ({
+  killWithDescendantSweep: killWithDescendantSweepMock
+}))
+
+type MutableSession = Session & { isAlive: boolean; isTerminating: boolean }
+
+function session(overrides: Partial<Session> = {}): MutableSession {
+  return {
+    launchAgent: null,
+    pid: 4321,
+    isAlive: true,
+    isTerminating: false,
+    beginTermination: vi.fn(function (this: MutableSession) {
+      if (this.isTerminating) return false
+      this.isTerminating = true
+      return true
+    }),
+    terminateOwnedBoundary: vi.fn(async () => 'terminated' as const),
+    terminateOwnedTree: vi.fn(() => 'unavailable' as const),
+    scheduleForceDisposeFallback: vi.fn(),
+    signalTerminationRoot: vi.fn(),
+    forceKillAndWaitForExit: vi.fn(async () => {}),
+    ...overrides
+  } as unknown as MutableSession
+}
+
+describe('TerminalSessionTeardown owned-tree policy', () => {
+  beforeEach(() => {
+    killWithDescendantSweepMock.mockReset()
+    killWithDescendantSweepMock.mockImplementation(
+      async (_pid: number, signalRoot: () => void) => signalRoot()
+    )
+  })
+
+  it('captures descendants for a hand-typed agent whose launchAgent is null', async () => {
+    const target = session({ launchAgent: null })
+    const teardown = new TerminalSessionTeardown(new Map([['s1', target]]))
+
+    await teardown.killSession('s1', target, false)
+
+    expect(killWithDescendantSweepMock).toHaveBeenCalledWith(
+      target.pid,
+      expect.any(Function),
+      expect.objectContaining({
+        ownsRoot: expect.any(Function),
+        terminateOwnedTree: expect.any(Function)
+      })
+    )
+    expect(target.terminateOwnedBoundary).toHaveBeenCalledWith('SIGTERM')
+    expect(target.signalTerminationRoot).toHaveBeenCalledOnce()
+    expect(target.scheduleForceDisposeFallback).toHaveBeenCalledOnce()
+  })
+
+  it('captures descendants for an ordinary plain shell too', async () => {
+    const target = session({ launchAgent: null })
+    const teardown = new TerminalSessionTeardown(new Map([['s1', target]]))
+
+    await teardown.killSession('s1', target, true)
+
+    expect(killWithDescendantSweepMock).toHaveBeenCalledOnce()
+    expect(target.terminateOwnedBoundary).toHaveBeenCalledWith('SIGKILL')
+    expect(target.forceKillAndWaitForExit).toHaveBeenCalledOnce()
+  })
+
+  it('joins repeated close requests and escalates the shared operation', async () => {
+    let releaseSweep: (() => void) | null = null
+    killWithDescendantSweepMock.mockImplementation(
+      () => new Promise<void>((resolve) => (releaseSweep = resolve))
+    )
+    const target = session()
+    const teardown = new TerminalSessionTeardown(new Map([['s1', target]]))
+
+    const graceful = teardown.killSession('s1', target, false) as Promise<void>
+    const immediate = teardown.requestImmediate('s1')
+
+    expect(immediate).toBe(graceful)
+    expect(killWithDescendantSweepMock).toHaveBeenCalledOnce()
+    releaseSweep?.()
+    await graceful
+  })
+
+  it('does not signal a recycled pid after the session loses ownership', async () => {
+    const target = session()
+    const sessions = new Map<string, Session>([['s1', target]])
+    const teardown = new TerminalSessionTeardown(sessions)
+
+    await teardown.killSession('s1', target, false)
+    const options = killWithDescendantSweepMock.mock.calls[0]?.[2] as {
+      ownsRoot: () => boolean
+    }
+    expect(options.ownsRoot()).toBe(true)
+
+    sessions.delete('s1')
+    expect(options.ownsRoot()).toBe(false)
+  })
+})
