   }
 }
+
+
+function countLiveSessions(sessions: ReadonlyMap<string, Session>): number {
+  let count = 0
+  for (const session of sessions.values()) {
+    if (session.isAlive) {
+      count += 1
+    }
+  }
+  return count
+}
+
+function countLiveExplicitAgentSessions(sessions: ReadonlyMap<string, Session>): number {
+  let count = 0
+  for (const session of sessions.values()) {
+    if (session.isAlive && session.launchAgent) {
+      count += 1
+    }
+  }
+  return count
+}
