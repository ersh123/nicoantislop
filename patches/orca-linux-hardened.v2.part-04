+    const result = requestReclaimableWorkerTerminalReleases(db)
+
+    expect(requestWorkerTerminalRelease).not.toHaveBeenCalled()
+    expect(result).toEqual({ examined: 4, requested: 0, retained: 0, failed: 0 })
+  })
+
+  it('honors an explicit user retain even if a stale listing labels it reclaimable', () => {
+    const requestWorkerTerminalRelease = vi.fn()
+    const db = {
+      listWorkerTerminalResources: () => [
+        row('retained', 'reclaimable', {
+          resource: resource({ release_state: 'retained', retained_reason: 'user_requested' })
+        })
+      ],
+      requestWorkerTerminalRelease
+    }
+
+    requestReclaimableWorkerTerminalReleases(db)
+
+    expect(requestWorkerTerminalRelease).not.toHaveBeenCalled()
+  })
+
+  it('bounds one reconciliation pass and records retained or failed requests honestly', () => {
+    const requestWorkerTerminalRelease = vi
+      .fn()
+      .mockReturnValueOnce({
+        disposition: 'retained' as const,
+        resource: resource(),
+        reason: 'identity_unproven' as const
+      })
+      .mockImplementationOnce(() => {
+        throw new Error('database busy')
+      })
+      .mockReturnValue({ disposition: 'requested' as const, resource: resource() })
+    const db = {
+      listWorkerTerminalResources: () => [
+        row('one', 'reclaimable'),
+        row('two', 'reclaimable'),
+        row('three', 'reclaimable')
+      ],
+      requestWorkerTerminalRelease
+    }
+
+    const result = requestReclaimableWorkerTerminalReleases(db, { maxRequests: 2 })
+
+    expect(requestWorkerTerminalRelease.mock.calls).toEqual([['one'], ['two']])
+    expect(result).toEqual({ examined: 3, requested: 0, retained: 1, failed: 1 })
+  })
+})
diff --git a/src/renderer/src/components/native-chat/use-native-chat-composer-attachments-unmount.test.tsx b/src/renderer/src/components/native-chat/use-native-chat-composer-attachments-unmount.test.tsx
new file mode 100644
index 00000000..e8e2c55d
--- /dev/null
+++ b/src/renderer/src/components/native-chat/use-native-chat-composer-attachments-unmount.test.tsx
@@ -0,0 +1,70 @@
+// @vitest-environment happy-dom
+import { act, renderHook } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createRef } from 'react'
+import {
+  clearNativeChatAttachmentCacheForTests,
+  useNativeChatComposerAttachments
+} from './use-native-chat-composer-attachments'
+
+vi.mock('@/i18n/i18n', () => ({
+  translate: (_key: string, fallback: string) => fallback
+}))
+vi.mock('@/runtime/runtime-terminal-inspection', () => ({
+  isRemoteRuntimePtyId: () => false
+}))
+
+function renderAttachments() {
+  return renderHook(() =>
+    useNativeChatComposerAttachments({
+      attachmentScopeKey: 'pane-1',
+      caret: 0,
+      disabled: false,
+      isComposing: () => false,
+      resolveTarget: () => ({
+        ptyId: 'pty-1',
+        settings: { activeRuntimeEnvironmentId: null }
+      }),
+      textareaRef: createRef<HTMLTextAreaElement>(),
+      setCaret: () => {},
+      setDraft: () => {},
+      setNotice: () => {}
+    })
+  )
+}
+
+describe('native chat attachment preview lifetime', () => {
+  afterEach(() => {
+    clearNativeChatAttachmentCacheForTests()
+    vi.restoreAllMocks()
+  })
+
+  it('revokes a pending blob preview when the composer unmounts', () => {
+    const revoke = vi.spyOn(URL, 'revokeObjectURL').mockImplementation(() => undefined)
+    const view = renderAttachments()
+
+    act(() => {
+      view.result.current.beginPendingImageAttachment('blob:clipboard-preview')
+    })
+    view.unmount()
+
+    expect(revoke).toHaveBeenCalledTimes(1)
+    expect(revoke).toHaveBeenCalledWith('blob:clipboard-preview')
+  })
+
+  it('does not double-revoke a preview removed before unmount', () => {
+    const revoke = vi.spyOn(URL, 'revokeObjectURL').mockImplementation(() => undefined)
+    const view = renderAttachments()
+    let id: string | null = null
+
+    act(() => {
+      id = view.result.current.beginPendingImageAttachment('blob:clipboard-preview')
+    })
+    act(() => {
+      view.result.current.dropPendingImageAttachment(id as string)
+    })
+    view.unmount()
+
+    expect(revoke).toHaveBeenCalledTimes(1)
+  })
+})
