+import { describe, expect, it } from 'vitest'
+import type { AppState } from '@/store/types'
+import { FLOATING_TERMINAL_WORKTREE_ID } from '../../../shared/constants'
+import { brandEphemeralSetupTerminalWorktreeId } from '../../../shared/ephemeral-setup-terminal-worktree-id'
+import { folderWorkspaceKey } from '../../../shared/workspace-scope'
+import { hasRenderableTerminalWorktreeSurface } from './terminal-worktree-route'
+
+const EPHEMERAL_ID = brandEphemeralSetupTerminalWorktreeId('hardened-inline-setup')
+
+function state(worktreesByRepo: AppState['worktreesByRepo']): AppState {
+  return {
+    repos: [{ id: 'repo-1', executionHostId: 'local', connectionId: null }],
+    worktreesByRepo,
+    detectedWorktreesByRepo: {},
